{
  "name": "algorise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Sprint Zero scaffold for a gamified competitive-programming platform.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test extension/tests.test.mjs",
    "test:unit": "vitest run",
    "test:extension": "node --test extension/tests.test.mjs",
    "test:watch": "vitest",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "compose:validate": "node scripts/validate-compose.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run db:validate && npm run compose:validate && npm run build && npm run secrets:scan",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "visual:smoke": "node scripts/visual-smoke.mjs",
    "stress:web": "node scripts/web-stress.mjs",
    "llm:mock": "node scripts/mock-openai-server.mjs",
    "llm:smoke": "tsx scripts/llm-live-smoke.ts",
    "local:up": "sh scripts/local-up.sh",
    "local:down": "sh scripts/local-down.sh",
    "judge:roundtrip": "node scripts/judge-roundtrip.mjs",
    "judge:stress": "node scripts/judge-stress.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.7.0",
    "lucide-react": "1.25.0",
    "next": "16.2.10",
    "next-auth": "4.24.15",
    "openai": "6.48.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.61.1",
    "prisma": "6.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.10",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "uuid": "11.1.1",
    "postcss": "8.5.10"
  }
}
