# Copy to .env for local use. Replace placeholders locally; never commit real values.
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=PASTE_RANDOM_SECRET_HERE
# Local-only convenience. Keep false for shared/web deployments.
ALLOW_LOCAL_DEMO_AUTH=false
GOOGLE_CLIENT_ID=PASTE_OR_LEAVE_EMPTY
GOOGLE_CLIENT_SECRET=PASTE_OR_LEAVE_EMPTY

DATABASE_URL=postgresql://algorise:algorise@localhost:5432/algorise?schema=public
REDIS_URL=redis://localhost:6379
JUDGE_BASE_URL=http://localhost:3100
JUDGE_AUTH_TOKEN=PASTE_LOCAL_JUDGE_TOKEN
IMPORT_PAIRING_SECRET=PASTE_RANDOM_SECRET_HERE

# OpenAI-compatible providers. Model IDs pass through verbatim.
LLM_PRIMARY_BASE_URL=PASTE_BASE_URL_HERE
LLM_PRIMARY_API_KEY=PASTE_API_KEY_HERE
LLM_PRIMARY_PROTOCOL=chat
LLM_SECONDARY_BASE_URL=PASTE_OR_LEAVE_EMPTY
LLM_SECONDARY_API_KEY=PASTE_OR_LEAVE_EMPTY
LLM_SECONDARY_PROTOCOL=chat

# Thinking levels: minimal | low | medium | high
MODEL_ANALYST_ID=PASTE_MODEL_ID_HERE
MODEL_ANALYST_THINKING=high
MODEL_TESTGEN_ID=PASTE_MODEL_ID_HERE
MODEL_TESTGEN_THINKING=high
MODEL_JUDGE_FEEDBACK_ID=PASTE_MODEL_ID_HERE
MODEL_JUDGE_FEEDBACK_THINKING=high
MODEL_MENTOR_ID=PASTE_MODEL_ID_HERE
MODEL_MENTOR_THINKING=medium
MODEL_CONTENT_ID=PASTE_MODEL_ID_HERE
MODEL_CONTENT_THINKING=medium
MODEL_LITE_ID=PASTE_MODEL_ID_HERE
MODEL_LITE_THINKING=minimal

LLM_DAILY_BUDGET_USD_TOTAL=10
LLM_MENTOR_DAILY_TOKENS_PER_USER=20000
LLM_KILL_SWITCH=false

# Feature flags. Riskier collectors stay off until founder-account spikes pass.
FEATURE_IMPORT_CODEFORCES=true
FEATURE_IMPORT_LEETCODE=false
FEATURE_IMPORT_ATCODER=false
FEATURE_IMPORT_CODECHEF=false
